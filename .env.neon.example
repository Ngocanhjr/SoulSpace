# Copy to .env.neon; replace host/database with the direct Neon endpoint.
# Use the same database for runtime and Flyway; provision roles first.
DB_URL=jdbc:postgresql://<neon-direct-host>/<database>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&channelBinding=require
DB_USER=soulspace_runtime
DB_PASSWORD=
FLYWAY_URL=jdbc:postgresql://<neon-direct-host>/<database>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&channelBinding=require
FLYWAY_USER=soulspace_migrator
FLYWAY_PASSWORD=
MEDIA_NAMESPACE=soulspace-neon-demo
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
DEMO_USER_PASSWORD=
