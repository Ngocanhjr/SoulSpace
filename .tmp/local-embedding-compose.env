# Copy to .env.docker. Spring Boot starts from soulspace/.
# Use three different passwords; do not commit .env.docker.
POSTGRES_DB=soulspace
POSTGRES_PASSWORD=dummy-postgres
DB_URL=jdbc:postgresql://127.0.0.1:5432/soulspace
DB_USER=soulspace_runtime
DB_PASSWORD=dummy-runtime
FLYWAY_URL=jdbc:postgresql://127.0.0.1:5432/soulspace
FLYWAY_USER=soulspace_migrator
FLYWAY_PASSWORD=dummy-migrator
MEDIA_NAMESPACE=soulspace/local
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
DEMO_USER_PASSWORD=
# Jina remains an external API; needed by embedding/search.
JINA_API_KEY=
# Enable after running semantic-search/sql/setup-embeddings.sql.
embedding.worker.enabled=false
embedding.worker.delay-ms=5000
