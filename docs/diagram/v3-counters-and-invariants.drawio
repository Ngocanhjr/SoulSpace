        <mxCell id="header-title" value="09A · Bài cuối cùng phải có chữ hoặc ảnh" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=32;fontStyle=1;" vertex="1" parent="1">
