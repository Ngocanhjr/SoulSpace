        </mxCell>
        <mxCell id="example-body" value="Ban đầu: Bài của An có một bình luận gốc ở cấp 1.&lt;br&gt;Thao tác: Bình trả lời bình luận này, tạo một bình luận ở cấp 2.&lt;br&gt;Kết quả: Cho phép nếu cha tồn tại trong cùng bài và chưa xóa.&lt;br&gt;Trả lời cấp 5 tạo cấp 6; cấp sâu hơn vẫn hợp lệ, không có giới hạn cứng độ sâu." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="90" y="204" width="2150" height="190" as="geometry" />
        </mxCell>
        <mxCell id="business-title" value="Diễn tiến và kết quả theo tình huống" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="405" width="2150" height="40" as="geometry" />
        </mxCell>
