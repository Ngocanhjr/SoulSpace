        </mxCell>
        <mxCell id="example-body" value="Ban đầu: Bài của An có 20 lượt thích; Bình chưa thích bài.&lt;br&gt;Thêm lượt thích của Bình làm tổng tăng lên 21.&lt;br&gt;Gỡ lượt thích đó làm tổng giảm về 20.&lt;br&gt;Cùng cơ chế cộng/trừ được dùng cho lượt chia sẻ và thích bình luận." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="90" y="204" width="1350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="business-title" value="Diễn tiến và kết quả theo tình huống" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="405" width="1350" height="40" as="geometry" />
        </mxCell>
      </root>
