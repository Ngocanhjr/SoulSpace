        </mxCell>
        <mxCell id="header-subtitle" value="Sơ đồ diễn giải tình huống; đọc trang B kế tiếp để đối chiếu luồng SQL." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="90" y="80" width="1417.5" height="50" as="geometry" />
        </mxCell>
        <mxCell id="example-title" value="Ví dụ thực tế" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="154" width="1417.5" height="38" as="geometry" />
        </mxCell>
        <mxCell id="example-body" value="Ban đầu: An muốn đăng một bài chỉ có ảnh, không có chữ.&lt;br&gt;Thao tác: Tạo bài rỗng rồi gắn ảnh trong cùng một giao dịch.&lt;br&gt;Kết quả: Cho phép lưu vì trạng thái cuối đã có ảnh.&lt;br&gt;Xóa ảnh cuối cùng mà không thêm chữ hoặc ảnh thay thế bị từ chối." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="90" y="204" width="1417.5" height="190" as="geometry" />
        </mxCell>
        <mxCell id="business-title" value="Diễn tiến và kết quả theo tình huống" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontColor=#0f172a;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="405" width="1417.5" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
