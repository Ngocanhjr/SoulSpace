flowchart TD
    START(["Bắt đầu"]) --> INPUT[/"An thay đổi liên kết ảnh M của bài A;<br>ví dụ đổi vị trí từ 0 sang ô 1 đang trống"/]
    INPUT --> CHANGE{"Đang sửa liên kết để đổi sang<br>bài khác hoặc ảnh khác?"}
    CHANGE -->|"Có"|DENY[/"Từ chối sửa trực tiếp liên kết hiện có"/]
    CHANGE -->|"Không"|LOCK["Khóa đúng bài trước khi tiếp tục<br>thêm, gỡ hoặc sắp xếp ảnh"]
    LOCK --> OK[/"Cho phép tiếp tục thay đổi liên kết;<br>vẫn phải qua các kiểm tra nghiệp vụ khác"/]
    OK --> FINISH(["Kết thúc"])
    DENY --> FINISH
    classDef terminal fill:#d5e8d4,stroke:#82b366,color:#18351d;
    classDef process fill:#dae8fc,stroke:#6c8ebf,color:#142d4e;
    classDef decision fill:#fff2cc,stroke:#d6b656,color:#443511;
    classDef io fill:#ffe6cc,stroke:#d79b00,color:#482b0d;
    classDef error fill:#f8cecc,stroke:#b85450,color:#5c1d1a;
    class START,FINISH terminal;
    class INPUT,OK io;
    class LOCK process;
    class CHANGE decision;
    class DENY error;
