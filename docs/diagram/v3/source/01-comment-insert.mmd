%% Ví dụ thực tế trước luồng SQL:
%% Ban đầu: Bài của An có một bình luận gốc ở cấp 1.
%% Thao tác: Bình trả lời bình luận này, tạo một bình luận ở cấp 2.
%% Kết quả: Cho phép nếu bình luận cha còn tồn tại và chưa xóa.
%% Trả lời bình luận cấp 5 tạo cấp 6; cấp sâu hơn vẫn hợp lệ, không có giới hạn cứng độ sâu.
flowchart TD
    START(["Bắt đầu: validate_comment INSERT"]) --> INPUT[/"Nhận NEW.blog_id và NEW.parent_id"/]
    INPUT --> LOCK_BLOG["Khóa blog bằng FOR UPDATE"]
    LOCK_BLOG --> ROOT{"NEW.parent_id là NULL?"}
    ROOT -->|"Có: comment gốc"|RETURN[/"RETURN NEW: cho phép tiếp tục INSERT"/]
    ROOT -->|"Không: reply"|LOCK_PARENT["SELECT parent cùng blog FOR UPDATE;<br>lấy deleted_at"]
    LOCK_PARENT --> FOUND{"Tìm thấy parent?"}
    FOUND -->|"Không"|MISSING["RAISE COMMENT_PARENT_NOT_FOUND"]
    MISSING --> E23503[/"Lỗi SQLSTATE 23503"/]
    FOUND -->|"Có"|DELETED{"Parent đã bị xóa?"}
    DELETED -->|"Có"|GONE["RAISE COMMENT_DELETED"]
    GONE --> E23514[/"Lỗi SQLSTATE 23514"/]
    DELETED -->|"Không"|RETURN
    RETURN --> FINISH(["Kết thúc bình thường"])
    E23503 --> ERROR_END(["Thoát bằng lỗi"])
    E23514 --> ERROR_END
    classDef terminal fill:#d5e8d4,stroke:#82b366,color:#18351d;
    classDef process fill:#dae8fc,stroke:#6c8ebf,color:#142d4e;
    classDef decision fill:#fff2cc,stroke:#d6b656,color:#443511;
    classDef io fill:#ffe6cc,stroke:#d79b00,color:#482b0d;
    classDef error fill:#f8cecc,stroke:#b85450,color:#5c1d1a;
    class START,FINISH,ERROR_END terminal;
    class LOCK_BLOG,LOCK_PARENT process;
    class ROOT,FOUND,DELETED decision;
    class INPUT,RETURN io;
    class MISSING,GONE,E23503,E23514 error;
