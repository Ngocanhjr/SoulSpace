%% Ví dụ thực tế trước luồng SQL:
%% Ban đầu: Bình muốn thích một bình luận trên bài của An.
%% Bình luận còn tồn tại và chưa xóa: Tiếp tục thêm lượt thích.
%% Bình luận đã bị xóa hoặc không tồn tại: Từ chối.
%% Hệ thống khóa bài trước rồi mới khóa bình luận để kiểm tra.
flowchart TD
    START(["Bắt đầu: guard_comment_like"]) --> INPUT[/"Nhận NEW.comment_id"/]
    INPUT --> LOOKUP[/"Đọc blog_id từ comments<br>theo NEW.comment_id"/]
    LOOKUP --> LOCK_BLOG["Khóa blog bằng FOR UPDATE"]
    LOCK_BLOG --> LOCK_COMMENT["SELECT comment FOR UPDATE;<br>lấy deleted_at"]
    LOCK_COMMENT --> FOUND{"Tìm thấy comment?"}
    FOUND -->|"Không"|MISSING["RAISE COMMENT_NOT_FOUND"]
    MISSING --> E23503[/"Lỗi SQLSTATE 23503"/]
    FOUND -->|"Có"|DELETED{"deleted_at khác NULL?"}
    DELETED -->|"Có"|GONE["RAISE COMMENT_DELETED"]
    GONE --> E23514[/"Lỗi SQLSTATE 23514"/]
    DELETED -->|"Không"|RETURN[/"RETURN NEW:<br>tiếp tục INSERT comment_likes"/]
    RETURN --> FINISH(["Kết thúc bình thường"])
    E23503 --> ERROR_END(["Thoát bằng lỗi"])
    E23514 --> ERROR_END
    classDef terminal fill:#d5e8d4,stroke:#82b366,color:#18351d;
    classDef process fill:#dae8fc,stroke:#6c8ebf,color:#142d4e;
    classDef decision fill:#fff2cc,stroke:#d6b656,color:#443511;
    classDef io fill:#ffe6cc,stroke:#d79b00,color:#482b0d;
    classDef error fill:#f8cecc,stroke:#b85450,color:#5c1d1a;
    class START,FINISH,ERROR_END terminal;
    class LOCK_BLOG,LOCK_COMMENT process;
    class FOUND,DELETED decision;
    class INPUT,LOOKUP,RETURN io;
    class MISSING,GONE,E23503,E23514 error;
