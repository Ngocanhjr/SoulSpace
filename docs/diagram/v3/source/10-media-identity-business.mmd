flowchart TD
    START(["Bắt đầu"]) --> INPUT[/"Nhận yêu cầu thay đổi ảnh M"/]
    INPUT --> IDENTITY{"Đổi căn cước, mục đích<br>hoặc mã lưu trữ đã xác nhận?"}
    IDENTITY -->|"Có"|DENY[/"Từ chối thay đổi không hợp lệ"/]
    IDENTITY -->|"Không"|PENDING{"Ảnh đang chờ xóa<br>nhưng bị đổi ngược trạng thái?"}
    PENDING -->|"Có"|DENY
    PENDING -->|"Không"|ATTACHED{"Ảnh đã gắn vào bài<br>nhưng bị quay về chờ gắn?"}
    ATTACHED -->|"Có"|DENY
    ATTACHED -->|"Không"|METADATA{"Đổi định dạng hoặc kích thước<br>của ảnh đã xác nhận?"}
    METADATA -->|"Có"|DENY
    METADATA -->|"Không"|OK[/"Cho phép tiếp tục cập nhật;<br>ví dụ đánh dấu ảnh đã gắn để chờ xóa"/]
    OK --> FINISH(["Kết thúc"])
    DENY --> FINISH
    classDef terminal fill:#d5e8d4,stroke:#82b366,color:#18351d;
    classDef process fill:#dae8fc,stroke:#6c8ebf,color:#142d4e;
    classDef decision fill:#fff2cc,stroke:#d6b656,color:#443511;
    classDef io fill:#ffe6cc,stroke:#d79b00,color:#482b0d;
    classDef error fill:#f8cecc,stroke:#b85450,color:#5c1d1a;
    class START,FINISH terminal;
    class INPUT,OK io;
    class IDENTITY,PENDING,ATTACHED,METADATA decision;
    class DENY error;
