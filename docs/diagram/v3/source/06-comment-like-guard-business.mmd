flowchart TD
    START(["Bắt đầu"]) --> INPUT[/"Bình bấm Thích một bình luận"/]
    INPUT --> LOCK["Khóa bài trước rồi khóa bình luận<br>để kiểm tra trạng thái nhất quán"]
    LOCK --> EXISTS{"Bình luận còn tồn tại?"}
    EXISTS -->|"Không"|MISSING[/"Từ chối: không tìm thấy bình luận"/]
    EXISTS -->|"Có"|DELETED{"Bình luận đã bị xóa?"}
    DELETED -->|"Có"|GONE[/"Từ chối: bình luận đã xóa"/]
    DELETED -->|"Không"|OK[/"Cho phép tiếp tục ghi lượt thích"/]
    MISSING --> FINISH(["Kết thúc"])
    GONE --> FINISH
    OK --> FINISH
    classDef terminal fill:#d5e8d4,stroke:#82b366,color:#18351d;
    classDef process fill:#dae8fc,stroke:#6c8ebf,color:#142d4e;
    classDef decision fill:#fff2cc,stroke:#d6b656,color:#443511;
    classDef io fill:#ffe6cc,stroke:#d79b00,color:#482b0d;
    classDef error fill:#f8cecc,stroke:#b85450,color:#5c1d1a;
    class START,FINISH terminal;
    class INPUT,OK io;
    class LOCK process;
    class EXISTS,DELETED decision;
    class MISSING,GONE error;
