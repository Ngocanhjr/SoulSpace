<mxfile host="drawio" data-source="../../../soulspace/src/main/resources/db/migration/V3__counters_and_invariants.sql">
  <diagram id="v3-notification-events" name="11 · Tương tác tạo thông báo">
    <mxGraphModel page="0" grid="1" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Tương tác → Trigger → Thông báo" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;text;fillColor=none;strokeColor=none;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Bắt đầu thao tác thêm tương tác" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="800" height="80" as="geometry" />
        </mxCell>
        <mxCell id="write" value="INSERT vào bảng tương tác&lt;br&gt;blog_likes / comment_likes&lt;br&gt;comments / blog_shares" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="800" height="140" as="geometry" />
        </mxCell>
        <mxCell id="new" value="INSERT thực sự&lt;br&gt;thêm một hàng mới?" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="AFTER INSERT · trigger tương ứng&lt;br&gt;blog_likes_notify / comment_likes_notify&lt;br&gt;comments_notify / blog_shares_notify" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="810" width="800" height="160" as="geometry" />
        </mxCell>
        <mxCell id="function" value="Gọi create_interaction_notification()&lt;br&gt;Like/share bài → chủ bài&lt;br&gt;Like comment → chủ comment&lt;br&gt;Comment → chủ bài; reply còn xét tác giả cha" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="1060" width="800" height="190" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="Có người nhận hợp lệ&lt;br&gt;và khác người thao tác?" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="1350" width="800" height="220" as="geometry" />
        </mxCell>
        <mxCell id="save" value="INSERT notifications cho từng người nhận&lt;br&gt;recipient_id, actor_id, blog_id, comment_id, type&lt;br&gt;created_at = now(); read_at = NULL&lt;br&gt;ON CONFLICT DO NOTHING nếu đã báo" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="1670" width="800" height="190" as="geometry" />
        </mxCell>
        <mxCell id="end" value="Kết thúc luồng thông báo&lt;br&gt;Caller quyết định COMMIT / ROLLBACK" style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="1990" width="800" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Đây là luồng trigger tạo dữ liệu, không phải đường khóa ngoại trong ERD.&lt;br&gt;Thông báo và tương tác cùng transaction; lỗi thì rollback cùng nhau.&lt;br&gt;Unlike/unshare giữ lịch sử. Không gửi push/email trong trigger." style="whiteSpace=wrap;html=1;fontSize=24;fontColor=#1f2937;strokeWidth=2;text;fillColor=none;strokeColor=none;fontSize=18;" vertex="1" parent="1">
