        <mxCell id="minus" value="Trigger · AFTER DELETE, mỗi hàng&lt;br&gt;blog_shares_counter&lt;br&gt;→ update_relation_counter()&lt;br&gt;UPDATE blogs: shares_count − 1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#183153;strokeWidth=1.5;spacing=12;rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
