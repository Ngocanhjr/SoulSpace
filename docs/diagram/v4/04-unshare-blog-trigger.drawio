        </mxCell>
        <mxCell id="end" value="Kết thúc procedure&lt;br&gt;Chưa đồng nghĩa đã COMMIT" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#183153;strokeWidth=1.5;spacing=12;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="570" y="2200" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Gỡ chia sẻ an toàn khi gọi lặp&lt;/b&gt;&lt;br&gt;Chỉ xóa quan hệ của p_actor với p_blog; không ảnh hưởng lượt share của người khác. Không cần quyền xem bài để gỡ share của chính mình.&lt;br&gt;Nếu không có quan hệ để xóa, procedure vẫn kết thúc bình thường và counter không giảm thêm. Hình thoi số hàng diễn giải DML/trigger, không phải IF mới trong SQL.&lt;br&gt;Trigger chạy trong DELETE, không chạy sau commit. Procedure và trigger dùng chung transaction của service; rollback hoàn tác cả quan hệ và counter.&lt;br&gt;Các lỗi CHECK/FK/UNIQUE hoặc lỗi nội bộ database khác vẫn áp dụng; sơ đồ không liệt kê mọi lỗi có thể phát sinh." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#183153;strokeWidth=1.5;spacing=12;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="200" y="2470" width="2320" height="190" as="geometry" />
        </mxCell>
