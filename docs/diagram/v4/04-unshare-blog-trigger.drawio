        </mxCell>
        <mxCell id="noop" value="Không có hàng bị xóa&lt;br&gt;Không gọi AFTER row trigger&lt;br&gt;shares_count giữ nguyên" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#183153;strokeWidth=1.5;spacing=12;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
