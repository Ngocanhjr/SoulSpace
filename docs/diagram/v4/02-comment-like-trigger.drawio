        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Cùng một transaction của service&lt;/b&gt;&lt;br&gt;Procedure không tự COMMIT; service đọc trạng thái/counter sau CALL và chỉ báo thành công sau COMMIT. Rollback hoàn tác cả lượt thích, counter và thông báo.&lt;br&gt;BEFORE INSERT guard_comment_like có thể chạy cả khi ON CONFLICT bỏ qua hàng trùng; chỉ AFTER row trigger cần hàng thực sự được thêm/xóa.&lt;br&gt;guard_comment_like được giải thích chi tiết ở sơ đồ V3 số 06. Khi counter cập nhật comments, comments_validate giữ nguyên version/updated_at vì không sửa nội dung/xóa/tác giả.&lt;br&gt;Bình luận đã xóa bị từ chối cho cả thích và bỏ thích; việc dọn likes khi xóa mềm thuộc transaction xóa bình luận." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColor=#183153;strokeWidth=1.5;spacing=12;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="200" y="4320" width="2320" height="220" as="geometry" />
        </mxCell>
