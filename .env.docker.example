# Copy to .env.docker. Working directory for Spring Boot: soulspace/.
# Supply three different passwords. Use KEY=value, no shell quotes/backslashes.
POSTGRES_DB=soulspace
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://127.0.0.1:5432/soulspace
DB_USER=soulspace_runtime
DB_PASSWORD=
FLYWAY_URL=jdbc:postgresql://127.0.0.1:5432/soulspace
FLYWAY_USER=soulspace_migrator
FLYWAY_PASSWORD=
MEDIA_NAMESPACE=soulspace/local
# Required for image uploads; text-only posts do not need Cloudinary.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
DEMO_USER_PASSWORD=

# Google OIDC: backend only. Keep disabled until Google Console is configured.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
APP_FRONTEND_URL=http://localhost:5173
